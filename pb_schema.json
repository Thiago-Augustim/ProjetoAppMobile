      "length": 6,
      "emailTemplate": {
        "subject": "OTP for {APP_NAME}",
        "body": "<p>Hello,</p>\n<p>Your one-time password is: <strong>{OTP}</strong></p>\n<p>Thanks,<br/>{APP_NAME} team</p>"
      }
    },
    "authToken": {
      "duration": 604800
    },
