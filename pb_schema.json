    "authAlert": {
      "enabled": true,
      "emailTemplate": {
        "subject": "Login from a new location",
        "body": "<p>Hello,</p>\n<p>We detected a login to your {APP_NAME} account from a new location.</p>\n<p>If this was not you, please immediately change your password.</p>\n<p>Thanks,<br/>{APP_NAME} team</p>"
      }
    },
